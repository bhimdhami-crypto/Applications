# Copy to apps/api/.env and adjust. Never commit real secrets.
DATABASE_URL=postgresql://hr:hr@localhost:5432/hrportal
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
# Sign-in codes
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Email: "smtp" sends through SMTP (Mailpit in development), "memory" keeps mail in memory (tests)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Mindspace HR <no-reply@mindspace-ai.test>"
# CAPTCHA: "turnstile" checks with Cloudflare Turnstile, "disabled" skips the check (tests only)
CAPTCHA_PROVIDER=turnstile
# Cloudflare's published test secret: always passes. Replace with your real secret in production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Create draft payroll runs automatically on the 20th of each month
PAYROLL_AUTODRAFT=true
# Where uploaded photos and HR documents are kept (relative to apps/api). Use object storage when going live.
STORAGE_DIR=storage
# "database" keeps uploaded files in Postgres instead, for hosts with no lasting disk (Vercel)
STORAGE_DRIVER=disk
# Public demo only, never with real data: lists the test accounts on the sign-in page and fills in the sign-in code
DEMO_MODE=false
WEB_ORIGIN=http://localhost:3000
PORT=4000
# Passwords for the seeded test accounts (development only). Keep the quotes: without them, # starts a comment.
SEED_ADMIN_PASSWORD="Admin#Mindspace2026"
SEED_USER_PASSWORD="Test#Mindspace2026"
