# Copy to apps/api/.env and adjust. Never commit real secrets.
DATABASE_URL=postgresql://hr:hr@localhost:5432/hrportal
# At least 16 random characters. Signs the 15-minute access tokens and hashes sign-in codes.
JWT_SECRET=replace-with-a-long-random-string
# Email: "smtp" sends through SMTP (Mailpit in development), "memory" keeps mail in memory (tests)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Mindspace Portal <no-reply@mindspace.test>"
# Demo only: show the sign-in code on screen instead of only by email. Ignored when NODE_ENV=production.
DEMO_SHOW_CODES=false
# Set to true behind HTTPS so the refresh-token cookie is only sent over TLS
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
PORT=4000
# Password for every seeded test account (development only). Keep the quotes: # starts a comment.
SEED_PASSWORD="Demo#Mindspace2026"
