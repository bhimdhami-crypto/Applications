// Mindspace Artificial Intelligence Inc. HR and payroll data model (milestone 1).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  PAYROLL
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  TERMINATED
}

enum WorkLocation {
  ON_SITE
  HYBRID
  FULLY_REMOTE
}

enum EmploymentType {
  PERMANENT
  FIXED_TERM
  INTERN
}

enum DocumentStatus {
  PENDING
  VERIFIED
  CLEARED
  EXPIRED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  FLOATING
  FAMILY_CARE
  COMPASSIONATE
  STUDY
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  DECLINED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  FINALIZED
}

/// One legal entity: the parent Inc. or a country subsidiary.
model Company {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  country     String
  countryCode String       @db.Char(2)
  currency    String       @db.Char(3)
  employees   Employee[]
  payrollRuns PayrollRun[]
  createdAt   DateTime     @default(now())
}

/// A login account. Admin accounts need not have an employee record.
model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  role         Role             @default(EMPLOYEE)
  isActive     Boolean          @default(true)
  employee     Employee?
  challenges   LoginChallenge[]
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

/// A pending second step of sign-in: the code emailed to the user.
model LoginChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model Employee {
  id                   String             @id @default(cuid())
  employeeNo           String             @unique
  firstName            String
  lastName             String
  jobTitle             String
  department           String
  grade                String?
  employmentType       EmploymentType     @default(PERMANENT)
  workLocation         WorkLocation       @default(ON_SITE)
  city                 String?
  /// Work email, also for staff who have no portal login yet
  workEmail            String?            @unique
  mobilePhone          String?
  personalEmail        String?
  gender               String?
  dateOfBirth          DateTime?          @db.Date
  maritalStatus        String?
  dependants           Int                @default(0)
  /// Sensitive identifiers: shown only to the employee, HR, payroll and admins
  nationalIdNumber     String?
  taxId                String?
  socialSecurityNo     String?
  highestQualification String?
  institution          String?
  qualificationYear    Int?
  /// Storage key of the profile photo
  photoKey             String?
  exitReason           String?
  hireDate             DateTime           @db.Date
  exitDate             DateTime?          @db.Date
  status               EmploymentStatus   @default(ACTIVE)
  /// Monthly base pay in the company's currency
  monthlyBasic         Decimal            @db.Decimal(14, 2)
  /// Monthly taxable cash allowances (housing, transport, remote work)
  monthlyAllowances    Decimal            @default(0) @db.Decimal(14, 2)
  companyId            String
  company              Company            @relation(fields: [companyId], references: [id])
  userId               String?            @unique
  user                 User?              @relation(fields: [userId], references: [id])
  managerId            String?
  manager              Employee?          @relation("Reports", fields: [managerId], references: [id])
  reports              Employee[]         @relation("Reports")
  payslips             Payslip[]
  nextOfKin            NextOfKin[]
  documents            EmployeeDocument[]
  leaveRequests        LeaveRequest[]
  leaveAdjustments     LeaveAdjustment[]
  /// Set when an admin deletes the employee. Records are kept for legal retention.
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([companyId, status])
}

model PayrollRun {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])
  periodYear        Int
  periodMonth       Int
  status            PayrollStatus @default(DRAFT)
  rulesPack         String
  rulesVersion      String
  totalGross        Decimal       @default(0) @db.Decimal(16, 2)
  totalDeductions   Decimal       @default(0) @db.Decimal(16, 2)
  totalNet          Decimal       @default(0) @db.Decimal(16, 2)
  totalEmployerCost Decimal       @default(0) @db.Decimal(16, 2)
  createdById       String?
  approvedById      String?
  approvedAt        DateTime?
  finalizedById     String?
  finalizedAt       DateTime?
  payslips          Payslip[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([companyId, periodYear, periodMonth])
}

model Payslip {
  id              String     @id @default(cuid())
  runId           String
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id])
  currency        String     @db.Char(3)
  gross           Decimal    @db.Decimal(14, 2)
  deductions      Decimal    @db.Decimal(14, 2)
  net             Decimal    @db.Decimal(14, 2)
  employerCost    Decimal    @db.Decimal(14, 2)
  /// Line items: [{ code, label, kind: EARNING | DEDUCTION | EMPLOYER, amount }]
  lines           Json
  /// Annual leave days left for the year at the end of the pay period, shown on the payslip
  annualLeaveLeft Int?
  createdAt       DateTime   @default(now())

  @@unique([runId, employeeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model NextOfKin {
  id                 String   @id @default(cuid())
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name               String
  relationship       String
  phone              String
  email              String?
  isEmergencyContact Boolean  @default(true)
  isBeneficiary      Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([employeeId])
}

/// An HR document on file for an employee. storageKey is null when only the paper copy is held.
model EmployeeDocument {
  id           String         @id @default(cuid())
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String
  fileName     String
  storageKey   String?
  mimeType     String?
  sizeBytes    Int?
  issuedDate   DateTime?      @db.Date
  expiryDate   DateTime?      @db.Date
  status       DocumentStatus @default(PENDING)
  /// Hidden from the employee themself (e.g. background checks)
  hrOnly       Boolean        @default(false)
  uploadedById String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([employeeId])
}

/// A leave request. Days are working days, after the country's weekend and public holidays.
model LeaveRequest {
  id               String      @id @default(cuid())
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             LeaveType
  startDate        DateTime    @db.Date
  endDate          DateTime    @db.Date
  days             Int
  reason           String?
  handoverTo       String?
  contactWhileAway String?
  /// Medical certificate or other supporting document
  documentId       String?
  status           LeaveStatus
  /// Employee who must approve first (their manager when the request was made)
  approverId       String?
  managerById      String?
  managerAt        DateTime?
  managerNote      String?
  hrById           String?
  hrAt             DateTime?
  hrNote           String?
  createdById      String?
  cancelledById    String?
  cancelledAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([employeeId, startDate])
  @@index([approverId, status])
  @@index([status, startDate])
}

/// HR correction to a leave balance, e.g. an opening balance or carry-over agreed outside the rules
model LeaveAdjustment {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType
  year        Int
  /// Days added (or removed when negative)
  days        Int
  reason      String
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([employeeId, year])
}

/// Public holidays per country. Generated each year as a draft; HR checks them against the gazette.
model PublicHoliday {
  id          String   @id @default(cuid())
  countryCode String   @db.Char(2)
  date        DateTime @db.Date
  name        String
  createdAt   DateTime @default(now())

  @@unique([countryCode, date])
}
