# ERP database (SQL Server Express). Prisma URL format for the API:
DATABASE_URL="sqlserver://localhost:1433;database=mfierp;user=sa;password=Erp#Local2026;trustServerCertificate=true"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4100
WEB_ORIGIN="http://localhost:3100"
# Document archive: a folder on the server or a backed-up network share (files are not stored in SQL Server)
ARCHIVE_DIR="archive"

# Approval emails. Leave SMTP_HOST empty to record emails without sending them (see Email outbox).
# Office 365: smtp.office365.com, port 587, a licensed mailbox or an SMTP relay account.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MFI ERP <erp@example.co.ke>"
# The address people open the ERP at, for the links in emails
APP_URL="http://localhost:3100"

# Seed: first admin account and fiscal calendar
SEED_ADMIN_EMAIL="admin@mfi-erp.test"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
FISCAL_YEAR_START_MONTH=1
SEED_FISCAL_YEARS="2026,2027"

# ETL. Evolution server WITHOUT a database name (the tool adds it per company).
# Use a SQL login that only has db_datareader on the Evolution databases.
EVO_CONNECTION="Server=192.168.180.124;User Id=erp_reader;Password=...;Encrypt=true;TrustServerCertificate=true"
EVO_DATABASES="MFI-DS,MFI-MDS,MFI-TS"
# ERP database for the ETL (same database as DATABASE_URL, in mssql connection-string form)
ERP_CONNECTION="Server=localhost,1433;Database=mfierp;User Id=sa;Password=Erp#Local2026;Encrypt=true;TrustServerCertificate=true"
