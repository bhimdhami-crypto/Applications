{
  "name": "@mfi-erp/etl",
  "version": "0.1.0",
  "private": true,
  "author": "Bhim Dhami",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "etl": "ts-node src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "mssql": "12.2.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/mssql": "9.1.11",
    "@types/node": "22.15.0",
    "jest": "29.7.0",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
